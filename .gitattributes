# Establish project-wide standard of LF line endings.
* text=auto eol=lf

# Binary files (binary is a macro for -text -diff).
*.pdf    binary
*.ico    binary
*.gif    binary
*.jpg    binary
*.png    binary
*.jpeg   binary
*.webp   binary

# Z-machine story files (test fixtures) — binary, never line-ending normalized.
*.z[1-8] binary
*.zblorb binary

# Treat SVG files as normalized text instead of binary.
*.svg    text

# Handle Windows specific files.
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf
*.psm1   text eol=crlf

# Improve diff output for Python files.
*.py     diff=python

# Export exclusions for archive.
.editorconfig            export-ignore
.gitattributes           export-ignore
.gitignore               export-ignore
.pre-commit-config.yaml  export-ignore
.github/                 export-ignore
tests/                   export-ignore
